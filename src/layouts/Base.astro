---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Intro from "../components/Intro.astro";
import { downloadPath, homePath, href, t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  page: "home" | "download" | "other";
  current?: string;
  noindex?: boolean;
}

const { locale, title, description, page, current, noindex = false } = Astro.props;
const d = t(locale);
const site = Astro.site ?? new URL("https://example.com");
const pathFor = (l: Locale) => (page === "download" ? downloadPath(l) : homePath(l));
const canonical = new URL(page === "other" ? Astro.url.pathname : pathFor(locale), site).href;
const altPt = new URL(pathFor("pt-br"), site).href;
const altEn = new URL(pathFor("en"), site).href;
const ogImage = new URL(href("/og.png"), site).href;
---

<!doctype html>
<html lang={d.lang} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0b0b" />
    <meta name="referrer" content="same-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    {
      page !== "other" && (
        <>
          <link rel="alternate" hreflang="pt-BR" href={altPt} />
          <link rel="alternate" hreflang="en" href={altEn} />
          <link rel="alternate" hreflang="x-default" href={altPt} />
        </>
      )
    }
    <link rel="icon" href={href("/mark.svg")} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Alexandria" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === "en" ? "en_US" : "pt_BR"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Decide a abertura antes da primeira pintura. Sem armazenamento: só sinais da própria navegação.
      (function () {
        try {
          var nav = performance.getEntriesByType("navigation")[0];
          var internal = document.referrer && new URL(document.referrer).origin === location.origin;
          var reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (!reduce && !location.hash && !internal && !(nav && nav.type === "back_forward")) {
            document.documentElement.classList.add("intro-on");
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <Intro d={d} />
    <a class="skip-link" href="#conteudo">{d.ui.skip}</a>
    <Header locale={locale} page={page} current={current} />
    <main id="conteudo" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
