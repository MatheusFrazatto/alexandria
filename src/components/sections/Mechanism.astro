---
import CatHead from "../CatHead.astro";
import Glyph from "../Glyph.astro";
import type { Dict } from "../../i18n";

interface Props {
  d: Dict;
}
const { d } = Astro.props;
const m = d.mechanism;
const kinds = ["source", "approved", "budget", "cite"] as const;
---

<section class="section mechanism" id="como-funciona" aria-labelledby="como-funciona-title" data-section="como-funciona">
  <div class="wrap section__grid">
    <header class="section__head">
      <CatHead id="como-funciona-title" no={m.no} name={m.name} />
    </header>
    <div class="section__body">
      <p class="statement">{m.statement}</p>
      <p class="prose mechanism__body">{m.body}</p>
    </div>

    <div class="steps" data-steps>
      <span class="steps__rail" aria-hidden="true"><span class="steps__rail-fill" data-steps-rail></span></span>
      <ol class="steps__list">
      {
        m.steps.map((s, i) => (
          <li class="step" data-step>
            <div class="step__glyph">
              <Glyph kind={kinds[i]!} />
            </div>
            <h3 class="step__title">
              <span class="step__no cat-no">{s.no}</span>
              <span class="step__name">{s.title}</span>
            </h3>
            <p class="step__text">{s.text}</p>
            <p class="step__data data">{s.data}</p>
          </li>
        ))
      }
      </ol>
    </div>

    <p class="mechanism__foot">
      <span class="block" data-state="plot" aria-hidden="true"></span>
      {m.footnote}
    </p>
  </div>
</section>

<style>
  .mechanism__body {
    margin-top: 1.75rem;
  }

  .steps {
    position: relative;
    grid-column: 1 / -1;
    border-top: 1px solid var(--line-2);
    border-bottom: 1px solid var(--line-2);
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }
  .steps__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .steps__rail {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(clamp(2rem, 3vw, 2.75rem) + clamp(5.5rem, 8.5vw, 8rem) / 2);
    height: 1px;
    background: var(--line-2);
    pointer-events: none;
  }
  .steps__rail-fill {
    display: block;
    height: 100%;
    background: var(--blue);
    transform-origin: left center;
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(2rem, 3vw, 2.75rem) clamp(1rem, 2vw, 1.75rem) 2.25rem;
  }
  .step + .step {
    border-left: 1px solid var(--line);
  }
  .step:first-of-type {
    padding-left: 0;
  }
  .step__glyph {
    position: relative;
    z-index: 1;
    width: clamp(5.5rem, 8.5vw, 8rem);
    padding: 0.5rem;
    margin-left: -0.5rem;
    background: var(--black);
  }
  .step__title {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-weight: inherit;
  }
  .step__no {
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }
  .step__name {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .step__text {
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .step__data {
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--ink-2);
  }
  .step:last-child .step__data {
    color: var(--blue-text);
  }

  .mechanism__foot {
    grid-column: 5 / -1;
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
    max-width: 58ch;
    color: var(--ink);
  }

  @media (max-width: 1020px) {
    .steps__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .steps__rail {
      display: none;
    }
    .step:nth-of-type(3) {
      border-left: 0;
      padding-left: 0;
    }
    .step:nth-of-type(n + 3) {
      border-top: 1px solid var(--line);
    }
    .mechanism__foot {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 620px) {
    .steps__list {
      grid-template-columns: 1fr;
    }
    .step {
      padding-left: 0;
      padding-right: 0;
    }
    .step + .step {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
