---
// Marca arquitetônica do Alexandria (desenho único em src/lib/mark.ts).
import MarkPaths from "./MarkPaths.astro";
import { MARK_VIEWBOX } from "../lib/mark";

interface Props {
  id: string;
  class?: string;
  label?: string;
}
const { id, class: className, label } = Astro.props;
---

<svg
  class={className}
  viewBox={MARK_VIEWBOX}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  <MarkPaths id={id} />
</svg>
